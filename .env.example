# Copy to .env and fill real values. Never commit .env.

APP_ENV=development
PORT=8080

# ---------------------------------------------------------------------------
# Self-hosted PostgreSQL (Docker Compose service: db)
# - Inside compose (server api container): host = db
# - Local start.bat (Go on host): host = 127.0.0.1
# Always set sslmode=disable for this stack (config defaults to require otherwise).
# ---------------------------------------------------------------------------
POSTGRES_DB=pmas
POSTGRES_USER=pmas
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Local (start.bat / go run on host):
SUPABASE_DB_URL=postgresql://pmas:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@127.0.0.1:5432/pmas?sslmode=disable

# Server Docker (api container talks to db service) — use this on the server .env instead:
# SUPABASE_DB_URL=postgresql://pmas:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/pmas?sslmode=disable

# Optional Postgres tuning (compose db service)
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=128MB
# PG_MAX_CONNECTIONS=100

# Min 32 random characters — never reuse placeholders
JWT_SECRET=

# Any long random string; used as AES-GCM key material for credential vault
CREDENTIALS_ENCRYPTION_KEY=

# Comma-separated exact origins (scheme + host + port).
# Use * to temporarily allow any Origin (reflects request Origin; not for long-term prod).
CORS_ALLOWED_ORIGINS=*

# WebAuthn / Passkeys (RP ID = host without scheme/port; origins = full frontend origins)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=PMAS Live
WEBAUTHN_RP_ORIGINS=http://localhost:3000

# Optional — local Grafana via start.bat only (not used on server Docker)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Enterprise chat subsystem (set true for local Messenger / Phase 2+)
CHAT_ENABLED=false
CHAT_MAX_MESSAGE_LENGTH=10000
CHAT_MESSAGE_RATE_RPM=30
CHAT_REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CHAT_WS_MAX_CONNECTIONS_PER_EMPLOYEE=5
CHAT_WS_MAX_CONNECTIONS_GLOBAL=10000
CHAT_WS_MAX_SUBSCRIPTIONS=100
CHAT_WS_MAX_MESSAGE_SIZE=8192
CHAT_WS_WRITE_QUEUE_SIZE=64
CHAT_WS_PING_INTERVAL=30s
CHAT_WS_PONG_TIMEOUT=10s
